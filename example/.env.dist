# GrepDB Chat Server Configuration

# Your Anthropic API key (required)
# Get one at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-API-KEY-HERE

# GrepDB server URL (optional, defaults to http://localhost:8080)
GREPDB_URL=http://localhost:8080

# Server port (optional, defaults to 3002)
PORT=3002